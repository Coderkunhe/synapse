{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "date +%s > /Users/USERNAME/projects/personal/ai/ai-synapse/synapse/.claude/session-hook-canary 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash tools/check-docs.sh 2>&1"
          },
          {
            "type": "command",
            "command": "bash tools/reset-batch-counter.sh 2>&1"
          }
        ]
      }
    ]
  }
}

# Synapse environment variables (local dev)
DATABASE_URL=sqlite+aiosqlite:///./data/synapse.db
# JWT_SECRET — 运行以下命令生成随机密钥后填入:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# P100-B105 安全校验拒绝默认 placeholder 值，必须使用随机生成的真实密钥。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
DEBUG=true

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/github/callback
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# SMTP Email (local dev: leave empty to skip email sending)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@synapse.local
# SMTP_FROM_NAME=Synapse
# SMTP_USE_TLS=true

# Feature flags (S-015 极简模式)
# FEATURES__PROJECT_COUNT=1   # 1 = single project mode (hide project list/selector)
# FEATURES__BATCH_SIZE=1      # 1 = single task mode (hide batch UI, 1 task = 1 batch)
# FEATURES__TEAMS=false        # false = hide teams (team degrades to worker attribute)

# WebPush (P10-B44 · VAPID keys — generate: openssl ecparam -genkey -name prime256v1 -out vapid_private.pem)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=admin@synapse.local

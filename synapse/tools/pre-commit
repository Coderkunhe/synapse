#!/usr/bin/env bash
# pre-commit wrapper — chains framework checks + Synapse governance gates
# Framework: .git/hooks/pre-commit.framework (auto-generated by pre-commit framework)
#
# Stage pipeline:
#   1. Framework pre-commit (glassmind)
#   2. L5 Gate — blocks when batchesSinceLastL5 ≥ 2
#   3. Schema audit — AuditFields inheritance check
#   4. Plan Mode entry detection (V-003)
#   5. Dependency change gate (GAP-10 · P100-B90)
#   6. Quality triple-axe gate (GAP-2 · P100-B91) — requires self-check file
#   7. Checkpoint freshness gate (GAP-3 · P100-B91) — requires today's checkpoint
#   8. Dogfood active gate — blocks src/ changes when dogfood-active flag exists
#   9. Worker JS test gate (P12-B27 · P12-2) — runs JS tests when scripts/ files change
#
# Install: ln -sf ../../synapse/tools/pre-commit .git/hooks/pre-commit

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Stage 1: Framework pre-commit (glassmind) ────────────
FRAMEWORK_HOOK="$REPO_ROOT/.git/hooks/pre-commit.framework"
if [ -x "$FRAMEWORK_HOOK" ]; then
  "$FRAMEWORK_HOOK" || {
    echo "❌ Framework pre-commit failed — fix issues before committing"
    exit 1
  }
fi

# ── Stage 2: Synapse L5 gate ─────────────────────────────
L5_GATE="$REPO_ROOT/synapse/tools/l5-gate.sh"
if [ -x "$L5_GATE" ]; then
  "$L5_GATE" || exit 1
fi

# ── Stage 2b: L5 counter consistency (mechanical gate · P13-B3) ──
# Blocks on counter mismatch across three sources (checkpoint·CLAUDE.md·memory)
# Bypass: SYNAPSE_SKIP_L5_CHECK=1 git commit ...
L5_CONSISTENCY="$REPO_ROOT/synapse/tools/check-l5-consistency.sh"
if [ -x "$L5_CONSISTENCY" ]; then
  if [ "${SYNAPSE_SKIP_L5_CHECK:-0}" = "1" ]; then
    echo "⚠️  L5 一致性检查已通过 SYNAPSE_SKIP_L5_CHECK=1 跳过（违纪已记录）"
    echo "   $(date -u +%Y-%m-%dT%H:%M:%SZ) pre-commit SYNAPSE_SKIP_L5_CHECK=1" \
      >> "$REPO_ROOT/synapse/.claude/l5-check-bypass.log" 2>/dev/null || true
  else
    "$L5_CONSISTENCY" --critical-only || {
      echo ""
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "🔴  L5 一致性门禁失败（P13-B3）"
      echo "🔴"
      echo "🔴  l5-checkpoint.json · CLAUDE.md · memory/active/*.md"
      echo "🔴  三源 counter 不一致。请修正后重新提交。"
      echo "🔴"
      echo "🔴  紧急跳过：SYNAPSE_SKIP_L5_CHECK=1 git commit ..."
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      exit 1
    }
  fi
fi

# ── Stage 3: Schema audit check ──────────────────────────
SCHEMA_AUDIT="$REPO_ROOT/synapse/tools/check-schema-audit.sh"
if [ -x "$SCHEMA_AUDIT" ]; then
  "$SCHEMA_AUDIT" || exit 1
fi

# ── Stage 4: Plan Mode entry detection (V-003) ─────────
PLAN_MODE="$REPO_ROOT/synapse/tools/check-plan-mode.sh"
if [ -x "$PLAN_MODE" ]; then
  "$PLAN_MODE" || exit 1
fi

# ── Stage 5: Dependency change gate (GAP-10 · P100-B90) ──
# 依赖文件变更 → 强制 make check 全量门禁，不可跳过
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")
DEP_FILES=$(echo "$STAGED_FILES" | grep -E '(^|/)requirements\.txt$|(^|/)package\.json$' || true)
if [[ -n "$DEP_FILES" ]]; then
  echo ""
  echo "📦 检测到依赖文件变更："
  echo "$DEP_FILES" | while read -r f; do echo "   • $f"; done
  echo ""
  echo "🔧 强制运行 make check（依赖升级门禁 · GAP-10）..."
  SYNAPSE_DIR="$REPO_ROOT/synapse"
  if [ -f "$SYNAPSE_DIR/Makefile" ]; then
    (cd "$SYNAPSE_DIR" && make check) || {
      echo ""
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "🔴  依赖变更门禁失败（GAP-10）"
      echo "🔴"
      echo "🔴  依赖文件变更后必须通过 make check 全量门禁。"
      echo "🔴  请修复以上失败项后重新提交。"
      echo "🔴"
      echo "🔴  变更的依赖文件："
      echo "$DEP_FILES" | while read -r f; do echo "🔴    • $f"; done
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      exit 1
    }
    echo "✅ 依赖变更门禁通过"
  else
    echo "⚠️  Makefile 未找到，跳过依赖门禁"
  fi
fi

# ── Stage 6: Quality triple-axe gate (GAP-2 · P100-B91) ──
# 代码文件变更 → 要求 .claude/self-check-*.md 存在且完整
QUALITY_GATE="$REPO_ROOT/synapse/tools/check-quality-gate.sh"
if [ -x "$QUALITY_GATE" ]; then
  "$QUALITY_GATE" || exit 1
fi

# ── Stage 7: Checkpoint freshness gate (GAP-3 · P100-B91) ──
# synapse/ 文件变更 → 要求 memory/active/*.md 今日已更新
CHECKPOINT_GATE="$REPO_ROOT/synapse/tools/check-checkpoint-freshness.sh"
if [ -x "$CHECKPOINT_GATE" ]; then
  "$CHECKPOINT_GATE" || exit 1
fi

# ── Stage 8: Dogfood active gate ─────────────────────────
# 狗粮期间 God's-eye 禁止直接修改 src/
DOGFOOD_GATE="$REPO_ROOT/synapse/tools/check-dogfood-gate.sh"
if [ -x "$DOGFOOD_GATE" ]; then
  "$DOGFOOD_GATE" || exit 1
fi

# ── Stage 9: Worker JS test gate (P12-B27 · P12-2) ───────
# JS 脚本变更 → 运行 Worker JS 单元测试，失败则阻断提交
STAGED_JS_FILES=$(git diff --cached --name-only 2>/dev/null | grep -E '^synapse/docs/templates/synapse-client/scripts/.*\.js$' || true)
if [[ -n "$STAGED_JS_FILES" ]]; then
  echo ""
  echo "🧪 检测到 Worker JS 脚本变更，运行 JS 测试..."
  SYNAPSE_DIR="$REPO_ROOT/synapse"
  if [ -f "$SYNAPSE_DIR/Makefile" ]; then
    (cd "$SYNAPSE_DIR" && make test-js) || {
      echo ""
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "🔴  Worker JS 测试失败（P12-2 · P12-B27）"
      echo "🔴"
      echo "🔴  JS 脚本变更必须通过 Worker JS 单元测试。"
      echo "🔴  请修复失败测试后重新提交。"
      echo "🔴  运行: cd synapse && make test-js"
      echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      exit 1
    }
    echo "✅ Worker JS 测试通过"
  else
    echo "⚠️  Makefile 未找到，跳过 JS 测试门禁"
  fi
fi

exit 0

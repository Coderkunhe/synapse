#!/usr/bin/env bash
# pre-push — Synapse Capability Gateway Hook
#
# 由 `synapse-exec --install-hook` 安装到 .git/hooks/pre-push。
# 推送到 main/master 时强制走 Synapse 审批链路。
#
# git pre-push hook 参数: <remote_name> <remote_url>
# hook 的 exit code: 0 = 放行, 非 0 = 阻断 push

set -euo pipefail

REMOTE="${1:-}"
URL="${2:-}"
BRANCH=$(git branch --show-current 2>/dev/null || echo "")

# ── 只拦截 main/master ──
if [[ "$BRANCH" != "main" ]] && [[ "$BRANCH" != "master" ]]; then
    exit 0
fi

# ── 逃逸通道检测（GAP-6 硬化 · P100-B90 · B115 双通道）─────────
# 通道 1: git push -o skip-synapse-check → GIT_PUSH_OPTION_0=skip-synapse-check
#          依赖远端 push-option 协商（Gitee 等部分远端不支持，此通道可能不可用）
# 通道 2: SYNAPSE_PUSH_BYPASS=1 git push → 纯客户端 env var，无条件可靠
# 未配置 Synapse 且未显式声明跳过 → 硬阻断，不再静默放行
SKIP_FLAG=""
# 通道 1: git push-option（依赖远端协商）
for opt in ${!GIT_PUSH_OPTION_*}; do
    if [[ "${!opt}" == "skip-synapse-check" ]]; then
        SKIP_FLAG="1"
        break
    fi
done
# 通道 2: 环境变量 fallback（纯客户端，Gitee 等不协商 push-option 的远端可用）
if [[ "${SYNAPSE_PUSH_BYPASS:-}" == "1" ]]; then
    SKIP_FLAG="1"
fi

if [[ -z "${SYNAPSE_API_URL:-}" ]] || ! command -v synapse-exec &>/dev/null; then
    if [[ -n "$SKIP_FLAG" ]]; then
        # 显式跳过 — 记录到本地审计 log
        LOG_FILE="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")/synapse/.claude/pre-push-bypass.log"
        echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] bypass: branch=${BRANCH} remote=${URL} skip_flag=yes" >> "$LOG_FILE"
        exit 0
    fi

    echo ""
    echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🔴  Synapse 未配置 — push 授权检查不可用"
    echo "🔴"
    echo "🔴  SYNAPSE_API_URL 未设置或 synapse-exec 未安装。"
    echo "🔴  推送到 ${BRANCH} 需要经过 Synapse 审批链路。"
    echo "🔴"
    echo "🔴  非 Worker 环境（God's-eye / 非 Synapse 项目）："
    echo "🔴    SYNAPSE_PUSH_BYPASS=1 git push origin master"
    echo "🔴    (或 git push -o skip-synapse-check — 部分远端可能不支持)"
    echo "🔴"
    echo "🔴  Worker 环境："
    echo "🔴    cd synapse && synapse-exec --install-hook"
    echo "🔴    确保 .env 中 SYNAPSE_API_URL 已配置"
    echo "🔴━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # 记录到本地审计 log
    LOG_FILE="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")/synapse/.claude/pre-push-bypass.log"
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] BLOCKED: branch=${BRANCH} remote=${URL} reason=no_synapse_no_skip_flag" >> "$LOG_FILE"

    exit 1
fi

echo "🛡️  Synapse: 推送到 ${BRANCH} 需要审批"
echo ""

# ── 收集即将 push 的 commit 信息 ──
# 格式化为 Bullet 列表，审批卡片直接可读
COMMIT_INFO=""
if git rev-parse "@{u}" &>/dev/null 2>&1; then
    COMMIT_LIST=$(git log --oneline "@{u}..HEAD" 2>/dev/null | head -10)
else
    COMMIT_LIST=$(git log --oneline -5 2>/dev/null)
fi
if [[ -n "$COMMIT_LIST" ]]; then
    # 每行前加 "• "，变成可读列表
    while IFS= read -r line; do
        COMMIT_INFO="${COMMIT_INFO}  • ${line}"$'\n'
    done <<< "$COMMIT_LIST"
    COMMIT_INFO="${COMMIT_INFO%$'\n'}"  # 去尾部换行
fi

# 拼接完整 prompt
REASON="Push to ${BRANCH}"$'\n'"Remote: ${URL}"
if [[ -n "$COMMIT_INFO" ]]; then
    REASON="${REASON}"$'\n\n'"Commits:"$'\n'"${COMMIT_INFO}"
fi

# 调用 synapse-exec — 内部完成 请求→审批→执行→上报
# synapse-exec 返回非零 → git push 被阻断
synapse-exec git_push_main --params BRANCH="${BRANCH}" --reason "${REASON}"
